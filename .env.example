DATABASE_URL="postgresql://username:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:5432/postgres"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_random_secret_with_openssl_rand_base64_32"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ── Multi-model optimization pipeline ──────────────────────────────────────
# Stage 1 — Gemini Flash: full-page DOM crawl, core GEO audit, llms.txt
# Google AI Studio API Key (Free from aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash-lite"

# Stage 2 — Qwen 3 via OpenRouter: clean JSON-LD & localized schema
# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="qwen/qwen3-32b"

# Stage 3 — Llama via Groq: real-time title & alt-tag suggestions
# Free key from https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# Set FREE_MODE="true" to allow unlimited free audits without deducting credits
FREE_MODE="true"

# (Optional / Legacy) MuAPI Key
# MUAPIAPP_API_KEY="your_muapi_api_key"
WEBHOOK_URL="http://localhost:3000"

STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
